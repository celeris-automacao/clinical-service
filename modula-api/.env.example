# Database Configuration (PostgreSQL Docker)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5435/modula_clinic

# Server Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET=replace-with-a-local-development-secret
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
APP_URL=http://127.0.0.1:5177
# Required for transactional email delivery.
RESEND_API_KEY=
# Private file storage: disk (EasyPanel/local) or replit (requires Replit sidecar).
STORAGE_PROVIDER=disk
# Absolute private directory; on EasyPanel mount a persistent volume here.
# Linux example: /var/lib/modula/uploads; Windows: C:\modula-data\uploads
LOCAL_UPLOAD_DIR=
# At least 32 characters. Keep stable across restarts. Never use a public VITE_* variable.
STORAGE_SIGNING_SECRET=
# Replit provider only: /bucket/private and comma-separated public search paths.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
# Optional comma-separated recipients for Enterprise plan inquiries.
# When unset, requests go to active users with the super_admin role.
PLAN_INQUIRY_EMAIL=

# Clerk Authentication (optional)
# Configure both variables to enable Clerk integration.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Frontend Configuration
BASE_PATH=/
