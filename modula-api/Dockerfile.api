# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.17.0 --activate

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY artifacts/api-server/package.json artifacts/api-server/package.json
COPY artifacts/clinic-mobile/package.json artifacts/clinic-mobile/package.json
COPY artifacts/clinic-web/package.json artifacts/clinic-web/package.json
COPY artifacts/mockup-sandbox/package.json artifacts/mockup-sandbox/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-spec/package.json lib/api-spec/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
COPY lib/db/package.json lib/db/package.json
COPY lib/integrations-openai-ai-react/package.json lib/integrations-openai-ai-react/package.json
COPY lib/integrations-openai-ai-server/package.json lib/integrations-openai-ai-server/package.json
COPY scripts/package.json scripts/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm --filter @workspace/api-server... install --frozen-lockfile

FROM dependencies AS builder

COPY . .

RUN pnpm --filter @workspace/api-server build
RUN pnpm --filter @workspace/api-server --prod deploy --legacy /api-server
RUN find /api-server -type f \( -name '.env' -o -name '.env.*' \) -delete \
  && rm -rf /api-server/src /api-server/.tsbuildinfo /api-server/vitest.config.ts /api-server/tsconfig.json /api-server/build.mjs /api-server/.replit-artifact

FROM base AS runtime

ENV NODE_ENV=production
ENV PORT=5000
ENV STORAGE_PROVIDER=disk
ENV LOCAL_UPLOAD_DIR=/var/lib/modula/uploads

WORKDIR /app

COPY --from=builder --chown=node:node /api-server ./artifacts/api-server
COPY --from=builder --chown=node:node /app/lib/db/migrations ./lib/db/migrations
RUN mkdir -p /var/lib/modula/uploads && chown node:node /var/lib/modula/uploads

USER node

EXPOSE 5000

WORKDIR /app/artifacts/api-server

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
